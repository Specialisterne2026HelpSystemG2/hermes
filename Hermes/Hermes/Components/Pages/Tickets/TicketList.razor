@* RF05 — ticket listing with filters and ordering. *@
@page "/tickets"
@using System.Security.Claims
@using Hermes.Common
@using Hermes.Data
@using Hermes.Models
@using Hermes.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITicketService TicketService
@inject ICategoryService CategoryService
@inject IUserService UserService

<PageTitle>Tickets</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets</h1>
        <p class="page-subtitle">
            @(isAdmin ? "Every request raised in Hermes." : "The requests you have raised.")
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/tickets/new">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            New Ticket
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <div class="banner banner-success" role="status">
        <span>@feedback</span>
        <button type="button" class="banner-close" aria-label="Dismiss message"
                @onclick="() => feedback = null">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="banner banner-danger" role="alert">@errorMessage</div>
}

@* ── Toolbar: search + dropdowns ── *@
<div class="toolbar">
    <div class="toolbarSearch">
        <label class="visually-hidden" for="search">Search tickets</label>
        <span class="searchIcon" aria-hidden="true"><i class="bi bi-search"></i></span>
        <input id="search" class="text-input searchInput" type="search"
               placeholder="Search for ticket"
               value="@filter.Search" @oninput="OnSearchChangedAsync" />
    </div>

    <div class="toolbarFilters">
        <label class="visually-hidden" for="category">Category</label>
        <select id="category" class="select-input filterSelect"
                value="@(filter.CategoryId?.ToString() ?? "")"
                @onchange="OnCategoryChangedAsync">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>

        @if (isAdmin)
        {
            <label class="visually-hidden" for="collaborator">Collaborator</label>
            <select id="collaborator" class="select-input filterSelect"
                    value="@(filter.CollaboratorId ?? "")"
                    @onchange="OnCollaboratorChangedAsync">
                <option value="">All users</option>
                @foreach (var user in collaborators)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </select>
        }

        <label class="visually-hidden" for="sort">Sort by</label>
        <select id="sort" class="select-input filterSelect"
                value="@sortValue" @onchange="OnSortChangedAsync">
            <option value="CreatedAt-desc">Newest first</option>
            <option value="CreatedAt-asc">Oldest first</option>
            <option value="Priority-desc">Highest priority</option>
            <option value="Priority-asc">Lowest priority</option>
        </select>

        <button type="button" class="btn btn-ghost btn-sm" @onclick="ResetFiltersAsync">Clear</button>
    </div>
</div>

@* ── Status tabs ── *@
<div class="tabs" role="tablist" aria-label="Ticket status">
    @foreach (var tab in StatusTabs)
    {
        <button type="button" role="tab"
                class="tab @(activeTab == tab.Status ? "tabActive" : null)"
                aria-selected="@(activeTab == tab.Status)"
                @onclick="() => SetTabAsync(tab.Status)">
            <i class="bi @tab.Icon" aria-hidden="true"></i>
            @tab.Label
        </button>
    }
</div>

@* ── Content ── *@
@if (loading)
{
    <p class="empty-note">Loading…</p>
}
else if (tickets.Count == 0)
{
    <div class="banner banner-info" role="status">No tickets match these filters.</div>
}
else
{
    <ul class="ticketList">
        @foreach (var ticket in tickets)
        {
            <li class="ticketCard" @key="ticket.Id">
                <div class="ticketCardHead">
                    <div class="ticketIdRow">
                        <span class="statusDot @StatusDotClass(ticket.Status)" aria-hidden="true"></span>
                        <span class="ticketId">Ticket# @ticket.Id</span>
                        @if (ticket.Priority >= TicketPriority.High)
                        {
                            <span class="pill pillHigh">@ticket.Priority.GetDisplayName()</span>
                        }
                    </div>
                    <time class="ticketTime" datetime="@ticket.CreatedAt.ToString("o")">
                        Posted @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </time>
                </div>

                <h2 class="ticketSubject">@ticket.Title</h2>
                <p class="ticketPreview">@ticket.Description</p>

                <div class="ticketCardFoot">
                    <div class="ticketMeta">
                        <div class="requester">
                            <span class="requesterAvatar" aria-hidden="true">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <span class="requesterName">@(ticket.CreatedBy?.Name ?? "Removed user")</span>
                        </div>
                        @if (ticket.Category is not null)
                        {
                            <span class="categoryBadge">@ticket.Category.Name</span>
                        }
                        <span class="pill @StatusPillClass(ticket.Status)">@ticket.Status.GetDisplayName()</span>
                    </div>
                    <a class="openLink" href="@($"/tickets/{ticket.Id}")">Open ticket</a>
                </div>
            </li>
        }
    </ul>

    <p class="empty-note ticketCount">@tickets.Count ticket(s) shown.</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "success")]
    public string? SuccessFromQuery { get; set; }

    private readonly TicketFilter filter = new();

    private IReadOnlyList<Ticket> tickets = Array.Empty<Ticket>();
    private IReadOnlyList<Category> categories = Array.Empty<Category>();
    private IReadOnlyList<ApplicationUser> collaborators = Array.Empty<ApplicationUser>();

    private string? currentUserId;
    private bool isAdmin;
    private bool loading = true;
    private string? feedback;
    private string? errorMessage;

    private string sortValue = "CreatedAt-desc";
    private TicketStatus? activeTab;

    private static readonly (TicketStatus? Status, string Label, string Icon)[] StatusTabs =
    {
        (null, "All tickets", "bi-ui-checks-grid"),
        (TicketStatus.Open, "Open", "bi-envelope"),
        (TicketStatus.InProgress, "On-going", "bi-clock-history"),
        (TicketStatus.Resolved, "Resolved", "bi-check-circle"),
        (TicketStatus.Closed, "Closed", "bi-x-circle")
    };

    protected override async Task OnInitializedAsync()
    {
        feedback = SuccessFromQuery;

        var state = await AuthState;
        currentUserId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isAdmin = state.User.IsInRole("Admin");

        filter.RestrictToUserId = isAdmin ? null : currentUserId;

        categories = await CategoryService.GetAllAsync();

        if (isAdmin)
        {
            collaborators = await UserService.GetAllAsync();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            tickets = await TicketService.GetAllAsync(filter);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the tickets: {ex.Message}";
            tickets = Array.Empty<Ticket>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnSearchChangedAsync(ChangeEventArgs e)
    {
        filter.Search = e.Value?.ToString();
        await LoadAsync();
    }

    private async Task OnCategoryChangedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        filter.CategoryId = int.TryParse(raw, out var id) ? id : null;
        await LoadAsync();
    }

    private async Task OnCollaboratorChangedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        filter.CollaboratorId = string.IsNullOrWhiteSpace(raw) ? null : raw;
        await LoadAsync();
    }

    private async Task OnSortChangedAsync(ChangeEventArgs e)
    {
        sortValue = e.Value?.ToString() ?? "CreatedAt-desc";

        var parts = sortValue.Split('-');
        filter.Sort = parts[0] == nameof(TicketSort.Priority) ? TicketSort.Priority : TicketSort.CreatedAt;
        filter.Descending = parts.Length < 2 || parts[1] == "desc";

        await LoadAsync();
    }

    private async Task SetTabAsync(TicketStatus? status)
    {
        activeTab = status;
        filter.Status = status;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        filter.Search = null;
        filter.CategoryId = null;
        filter.Status = null;
        filter.CollaboratorId = null;
        filter.Sort = TicketSort.CreatedAt;
        filter.Descending = true;
        sortValue = "CreatedAt-desc";
        activeTab = null;

        await LoadAsync();
    }

    private static string StatusDotClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "dotOpen",
        TicketStatus.InProgress => "dotInProgress",
        TicketStatus.Resolved => "dotResolved",
        TicketStatus.Closed => "dotClosed",
        _ => "dotOpen"
    };

    private static string StatusPillClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "pill-open",
        TicketStatus.InProgress => "pill-progress",
        TicketStatus.Resolved => "pill-resolved",
        _ => "pill-inactive"
    };

    private static string PriorityClass(TicketPriority priority) => priority switch
    {
        TicketPriority.Urgent => "pill-urgent",
        TicketPriority.High => "pill-high",
        TicketPriority.Low => "pill-inactive",
        _ => "pill-normal"
    };
}
