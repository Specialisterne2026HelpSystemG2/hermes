@* RF04.1, RF04.2 — reply area. RF07 — resolve, restricted to the requester. *@
@page "/tickets/{Id:int}"
@using System.Security.Claims
@using Hermes.Common
@using Hermes.Data
@using Hermes.Models
@using Hermes.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITicketService TicketService

<PageTitle>@(ticket is null ? "Ticket" : $"#{ticket.Id} {ticket.Title}")</PageTitle>

@if (loading)
{
    <p class="empty-note">Loading…</p>
}
else if (ticket is null)
{
    <div class="banner banner-danger" role="alert">Ticket not found.</div>
    <a class="btn btn-ghost" href="/tickets">Back to the list</a>
}
else if (!CanView)
{
    <div class="banner banner-danger" role="alert">
        You can only open tickets that you raised.
    </div>
    <a class="btn btn-ghost" href="/tickets">Back to the list</a>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">Tickets</h1>
        </div>
        <div class="page-actions">
            <a class="btn btn-ghost" href="/tickets">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="banner banner-success" role="status">
            <span>@feedback</span>
            <button type="button" class="banner-close" aria-label="Dismiss message"
                    @onclick="() => feedback = null">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="banner banner-danger" role="alert">@errorMessage</div>
    }

    @* ── Ticket card (header + description + replies) ── *@
    <article class="ticketCard">
        <header class="ticketHead">
            <div class="ticketIdRow">
                <span class="statusDot @StatusDotClass(ticket.Status)" aria-hidden="true"></span>
                <span class="ticketLabel">Ticket# @ticket.Id</span>
                <span class="pill @StatusPillClass(ticket.Status)">@ticket.Status.GetDisplayName()</span>
                @if (ticket.Priority >= TicketPriority.High)
                {
                    <span class="pill pillHigh">@ticket.Priority.GetDisplayName()</span>
                }
            </div>
            <time class="ticketTime" datetime="@ticket.CreatedAt.ToString("o")">
                Posted @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            </time>
        </header>

        <h2 class="ticketTitle">@ticket.Title</h2>

        <div class="ticketBody">@ticket.Description</div>

        @* ── Existing replies ── *@
        @if (ticket.Replies.Count > 0)
        {
            <div class="repliesSection">
                <h3 class="sectionHeading">Replies (@ticket.Replies.Count)</h3>
                <ol class="replyList">
                    @foreach (var reply in ticket.Replies)
                    {
                        <li class="reply @(reply.AuthorId == ticket.CreatedById ? "replyOwner" : "")"
                            @key="reply.Id">
                            <div class="replyHead">
                                <div class="replyAuthorRow">
                                    <span class="replyAvatar" aria-hidden="true">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <span class="replyAuthor">@(reply.Author?.Name ?? "Removed user")</span>
                                </div>
                                <time class="replyTime">
                                    @reply.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </time>
                            </div>
                            <p class="replyBody">@reply.Body</p>
                        </li>
                    }
                </ol>
            </div>
        }
    </article>

    @* ── Reply to Ticket form ── *@
    <section class="replyCard">
        <h3 class="sectionHeading">Reply to Ticket</h3>

        @if (ticket.Status == TicketStatus.Closed)
        {
            <p class="empty-note">This ticket is closed — no further replies can be added.</p>
        }
        else
        {
            <EditForm Model="replyModel" OnValidSubmit="SendReplyAsync" novalidate>
                <DataAnnotationsValidator />

                <div class="replyFormGrid">
                    <div class="replyField">
                        <label class="field-label" for="reply-author-display">Author</label>
                        <input id="reply-author-display" class="text-input"
                               value="@(ticket.CreatedBy?.Email ?? "—")" disabled aria-readonly="true" />
                    </div>

                    <div class="replyField">
                        <label class="field-label" for="reply-category-display">Category</label>
                        <input id="reply-category-display" class="text-input"
                               value="@(ticket.Category?.Name ?? "—")" disabled aria-readonly="true" />
                    </div>

                    <div class="replyField">
                        <label class="field-label" for="reply-status-display">Status</label>
                        @if (IsOwner)
                        {
                            <select id="reply-status-display" class="select-input"
                                    value="@ticket.Status"
                                    @onchange="ChangeStatusAsync"
                                    disabled="@changingStatus">
                                @foreach (var status in Enum.GetValues<TicketStatus>())
                                {
                                    <option value="@status">@status.GetDisplayName()</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input id="reply-status-display" class="text-input"
                                   value="@ticket.Status.GetDisplayName()" disabled aria-readonly="true" />
                        }
                    </div>
                </div>

                <div class="replyBodyField">
                    <label class="field-label" for="reply-body">Ticket Body</label>
                    <InputTextArea id="reply-body" class="text-input textarea" rows="5"
                                   @bind-Value="replyModel.Body"
                                   placeholder="Type ticket issue here.." />
                    <ValidationMessage For="@(() => replyModel.Body)" class="field-error" />
                </div>

                <div class="replyFormActions">
                    @if (IsOwner && ticket.Status != TicketStatus.Resolved && ticket.Status != TicketStatus.Closed)
                    {
                        <button type="button" class="btn btn-ghost"
                                disabled="@changingStatus"
                                @onclick="() => SetStatusAsync(TicketStatus.Resolved)">
                            Mark as resolved
                        </button>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@sending">
                        @(sending ? "Sending…" : "Submit Reply")
                    </button>
                </div>
            </EditForm>
        }
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Ticket? ticket;
    private ReplyFormModel replyModel = new();

    private string? currentUserId;
    private bool isAdmin;
    private bool loading = true;
    private bool sending;
    private bool changingStatus;
    private string? feedback;
    private string? errorMessage;

    private bool IsOwner => ticket?.CreatedById is not null && ticket.CreatedById == currentUserId;

    private bool IsAssignee => ticket?.AssignedToId is not null && ticket.AssignedToId == currentUserId;

    private bool CanView => isAdmin || IsOwner || IsAssignee;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        currentUserId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isAdmin = state.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            ticket = await TicketService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the ticket: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SendReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage = "Your session has expired. Sign in again.";
            return;
        }

        sending = true;
        errorMessage = null;

        var result = await TicketService.AddReplyAsync(Id, replyModel, currentUserId);

        sending = false;

        if (result.Succeeded)
        {
            replyModel = new ReplyFormModel();
            feedback = "Reply sent.";
            await LoadAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }

    private async Task ChangeStatusAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<TicketStatus>(e.Value?.ToString(), out var status))
        {
            await SetStatusAsync(status);
        }
    }

    private async Task SetStatusAsync(TicketStatus status)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        changingStatus = true;
        errorMessage = null;

        var result = await TicketService.ChangeStatusAsync(Id, status, currentUserId);

        changingStatus = false;

        if (result.Succeeded)
        {
            feedback = $"Status changed to {status.GetDisplayName()}.";
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        await LoadAsync();
    }

    private static string StatusDotClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "dotOpen",
        TicketStatus.InProgress => "dotInProgress",
        TicketStatus.Resolved => "dotResolved",
        TicketStatus.Closed => "dotClosed",
        _ => "dotOpen"
    };

    private static string StatusPillClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "pill-open",
        TicketStatus.InProgress => "pill-progress",
        TicketStatus.Resolved => "pill-resolved",
        _ => "pill-inactive"
    };
}
