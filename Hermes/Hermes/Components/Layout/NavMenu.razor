@using System.Security.Claims
@using Hermes.Services
@inject NavigationManager Navigation
@inject INotificationService NotificationService

<div class="logo-block">
    <div class="logo-text">
        ꒰১ HERMES ໒꒱
        <span>HELP TICKETING SYSTEM</span>
    </div>
</div>

<nav class="nav">
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill" aria-hidden="true"></i>
                Dashboard
            </NavLink>
            <NavLink class="nav-item" href="tickets">
                <i class="bi bi-ticket-perforated" aria-hidden="true"></i>
                Tickets
            </NavLink>
            <NavLink class="nav-item" href="notifications">
                <i class="bi bi-bell" aria-hidden="true"></i>
                Notifications
                @if (unreadCount > 0)
                {
                    <span class="nav-badge">@unreadCount</span>
                }
            </NavLink>
        </Authorized>
    </AuthorizeView>

    @* Only an admin can manage users (RF01), so hide what they cannot open. *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <NavLink class="nav-item" href="users">
                <i class="bi bi-people" aria-hidden="true"></i>
                Users
            </NavLink>
            <NavLink class="nav-item" href="categories">
                <i class="bi bi-tags" aria-hidden="true"></i>
                Categories
            </NavLink>
            <NavLink class="nav-item" href="departments">
                <i class="bi bi-building" aria-hidden="true"></i>
                Departments
            </NavLink>
            <NavLink class="nav-item">
                <i class="bi bi-gear" aria-hidden="true"></i>
                Settings
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

<div class="logout">
    <AuthorizeView>
        <Authorized>
            @* A POST is required here: signing out on a GET would let any page log
               the user out with an <img> tag. *@
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="nav-item logout-button">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    Log Out
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="nav-item" href="Account/Login">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                Log In
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string currentUrl = string.Empty;
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        // RF04.3 — badge next to the Notifications link.
        if (AuthState is null)
        {
            return;
        }

        var state = await AuthState;
        var userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userId))
        {
            try
            {
                unreadCount = await NotificationService.CountUnreadAsync(userId);
            }
            catch
            {
                // The nav must still render if the table is not migrated yet.
                unreadCount = 0;
            }
        }
    }
}
